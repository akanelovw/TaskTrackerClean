<?xml version="1.0" encoding="utf-8" ?>
<Shell
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:authViews="clr-namespace:TaskTracker.Maui.Features.Auth.Views"
    xmlns:projectViews="clr-namespace:TaskTracker.Maui.Features.Projects.Views"
    xmlns:usersViews="clr-namespace:TaskTracker.Maui.Features.Users.Views"
    x:Class="TaskTracker.Maui.AppShell"
    x:Name="RootShell">

    <Shell.FlyoutFooter>
        <Grid Padding="16" BackgroundColor="#111827">
            <Button
                Text="Logout"
                Clicked="LogoutClicked"
                BackgroundColor="#7F1D1D"
                TextColor="White"
                CornerRadius="10"
                HeightRequest="44" />
        </Grid>
    </Shell.FlyoutFooter>

    <ShellContent
        Route="login"
        Shell.FlyoutItemIsVisible="False"
        ContentTemplate="{DataTemplate authViews:LoginPage}" />

    <FlyoutItem Route="projects" Title="Projects">
        <ShellContent
            ContentTemplate="{DataTemplate projectViews:ProjectsPage}" />
    </FlyoutItem>

    <FlyoutItem
        Route="users"
        Title="Users"
        IsVisible="{Binding IsAdmin}">
        <ShellContent
            ContentTemplate="{DataTemplate usersViews:UsersPage}" />
    </FlyoutItem>

</Shell>