<?xml version="1.0" encoding="utf-8" ?>

<toolkit:Popup
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:Class="TaskTracker.Maui.Features.Documents.Popups.DocumentsPopup"
    BackgroundColor="Transparent">

    <Border
        BackgroundColor="#111827"
        StrokeThickness="0"
        StrokeShape="RoundRectangle 20"
        Padding="20"
        WidthRequest="480">

        <VerticalStackLayout Spacing="14">

            <Label
                Text="Project files"
                FontSize="18"
                TextColor="White"
                FontAttributes="Bold"/>

            <Border
                BackgroundColor="#1F2937"
                StrokeShape="RoundRectangle 16"
                Padding="20"
                x:Name="DropZone">

                <Border.GestureRecognizers>
                    <DropGestureRecognizer
                        AllowDrop="True"
                        DragOver="OnDragOver"
                        DragLeave="OnDragLeave"
                        Drop="OnDrop" />
                </Border.GestureRecognizers>

                <VerticalStackLayout Spacing="10">
                    <Label x:Name="DropLabel"
                           Text="Drag and Drop or pick file"
                           TextColor="#9CA3AF"
                           HorizontalOptions="Center"/>

                    <Button
                        Text="Upload"
                        Command="{Binding UploadCommand}"
                        BackgroundColor="#4F46E5"
                        TextColor="White"
                        CornerRadius="10"
                        HeightRequest="42"/>
                </VerticalStackLayout>
            </Border>

            <CollectionView ItemsSource="{Binding Documents}"
                             HeightRequest="220">

                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate>

                        <Grid ColumnDefinitions="*,Auto">

                            <Border
                                Grid.Column="0"
                                BackgroundColor="#1B2430"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 12"
                                Padding="12">

                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type toolkit:Popup}}, Path=BindingContext.OpenCommand}"
                                        CommandParameter="{Binding}" />
                                </Border.GestureRecognizers>

                                <HorizontalStackLayout Spacing="10">

                                    <Label Text="📄"
                                           FontSize="16"
                                           VerticalOptions="Center" />

                                    <Label
                                        Text="{Binding FileName}"
                                        TextColor="White"
                                        VerticalOptions="Center"
                                        LineBreakMode="TailTruncation" />

                                </HorizontalStackLayout>

                            </Border>

                            <Button
                                Grid.Column="1"
                                Text="✕"
                                WidthRequest="40"
                                HeightRequest="40"
                                BackgroundColor="Transparent"
                                TextColor="#EF4444"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type toolkit:Popup}}, Path=BindingContext.DeleteCommand}"
                                CommandParameter="{Binding}" />

                        </Grid>

                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">

                <Label Grid.Column="0"
                       Text="{Binding Page, StringFormat='Page {0}'}"
                       TextColor="#9CA3AF"
                       VerticalOptions="Center" />

                <Button Grid.Column="1"
                        Text="◀"
                        Command="{Binding PreviousPageCommand}"
                        IsEnabled="{Binding HasPreviousPage}"
                        BackgroundColor="#1F2937"
                        TextColor="White"
                        CornerRadius="10"
                        WidthRequest="44"
                        HeightRequest="36" />

                <Button Grid.Column="2"
                        Text="▶"
                        Command="{Binding NextPageCommand}"
                        IsEnabled="{Binding HasNextPage}"
                        BackgroundColor="#1F2937"
                        TextColor="White"
                        CornerRadius="10"
                        WidthRequest="44"
                        HeightRequest="36" />

            </Grid>

            <Button
                Text="Close"
                Clicked="Close"
                BackgroundColor="#374151"
                TextColor="White"
                CornerRadius="10"
                HeightRequest="42" />

        </VerticalStackLayout>

    </Border>

</toolkit:Popup>