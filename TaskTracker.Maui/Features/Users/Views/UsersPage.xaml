<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="TaskTracker.Maui.Features.Users.Views.UsersPage"
    BackgroundColor="#0B0F17">

    <Grid RowDefinitions="Auto,*,Auto">

        <Grid Grid.Row="0" Padding="20,24,20,10">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="900" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="1" ColumnDefinitions="*,Auto">

                <VerticalStackLayout Grid.Column="0" Spacing="6">

                    <Label Text="Users"
                           FontSize="32"
                           FontAttributes="Bold"
                           TextColor="White" />

                    <Label Text="Manage company users"
                           FontSize="14"
                           TextColor="#94A3B8" />

                </VerticalStackLayout>

                <Button Grid.Column="1"
                        Text="+ Create user"
                        Command="{Binding CreateCommand}"
                        BackgroundColor="#4F46E5"
                        TextColor="White"
                        CornerRadius="14"
                        HeightRequest="46"
                        Padding="18,0"
                        VerticalOptions="Center" />

            </Grid>

        </Grid>

        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="900" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <CollectionView Grid.Column="1"
                            ItemsSource="{Binding Users}"
                            SelectionMode="None"
                            Margin="0,10">

                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical"
                                       ItemSpacing="12" />
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>

                    <DataTemplate>

                        <Border
                            Padding="16"
                            BackgroundColor="#161B22"
                            StrokeThickness="1"
                            Stroke="#222B36"
                            StrokeShape="RoundRectangle 16">

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenCommand}"
                                    CommandParameter="{Binding}" />
                            </Border.GestureRecognizers>

                            <Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="14">
                                
                                <Border
                                    WidthRequest="40"
                                    HeightRequest="40"
                                    BackgroundColor="#312E81"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 20"
                                    VerticalOptions="Center">

                                    <Label
                                        Text="{Binding Email, Converter={StaticResource InitialsConverter}}"
                                        TextColor="White"
                                        FontAttributes="Bold"
                                        FontSize="13"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center" />

                                </Border>

                                <VerticalStackLayout Grid.Column="1"
                                                      VerticalOptions="Center"
                                                      Spacing="2">

                                    <Label Text="{Binding Email}"
                                           TextColor="White"
                                           FontAttributes="Bold"
                                           FontSize="15" />

                                    <Label Text="{Binding FirstName}"
                                           TextColor="#94A3B8"
                                           FontSize="13" />

                                    <Border
                                        Padding="8,3"
                                        BackgroundColor="#1F2937"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 8"
                                        HorizontalOptions="Start">

                                        <Label Text="{Binding Role}"
                                               TextColor="#9CA3AF"
                                               FontSize="11" />

                                    </Border>

                                </VerticalStackLayout>

                                <Button Grid.Column="2"
                                        Text="✕"
                                        TextColor="#EF4444"
                                        BackgroundColor="Transparent"
                                        FontSize="18"
                                        WidthRequest="40"
                                        HeightRequest="40"
                                        VerticalOptions="Center"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteCommand}"
                                        CommandParameter="{Binding}" />

                            </Grid>

                        </Border>

                    </DataTemplate>

                </CollectionView.ItemTemplate>

            </CollectionView>

        </Grid>

        <Grid Grid.Row="2" Padding="20,10,20,20">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="900" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="1"
                    BackgroundColor="#161B22"
                    StrokeThickness="1"
                    Stroke="#222B36"
                    StrokeShape="RoundRectangle 14"
                    Padding="16,10">

                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">

                    <Label Grid.Column="0"
                           Text="{Binding Page, StringFormat='Page {0}'}"
                           TextColor="#9CA3AF"
                           VerticalOptions="Center" />

                    <Button Grid.Column="1"
                            Text="◀ Prev"
                            Command="{Binding PreviousPageCommand}"
                            IsEnabled="{Binding HasPreviousPage}"
                            BackgroundColor="#1F2937"
                            TextColor="White"
                            CornerRadius="10"
                            HeightRequest="40"
                            Padding="14,0" />

                    <Button Grid.Column="2"
                            Text="Next ▶"
                            Command="{Binding NextPageCommand}"
                            IsEnabled="{Binding HasNextPage}"
                            BackgroundColor="#1F2937"
                            TextColor="White"
                            CornerRadius="10"
                            HeightRequest="40"
                            Padding="14,0" />

                </Grid>

            </Border>

        </Grid>

    </Grid>

</ContentPage>