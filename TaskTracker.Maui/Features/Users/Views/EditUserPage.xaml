<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="TaskTracker.Maui.Features.Users.Views.EditUserPage"
    BackgroundColor="#0B0F17">

    <ScrollView>

        <Grid Padding="20">
            <Border
                StrokeThickness="0"
                BackgroundColor="Transparent"
                HorizontalOptions="Center"
                MaximumWidthRequest="520"
                WidthRequest="520">

                <VerticalStackLayout Spacing="16">

                    <Label Text="Edit user"
                           FontSize="28"
                           FontAttributes="Bold"
                           TextColor="White"/>

                    <Border
                        Padding="18"
                        BackgroundColor="#111827"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 18">

                        <VerticalStackLayout Spacing="14">

                            <VerticalStackLayout Spacing="6">
                                <Label Text="Email" TextColor="#9CA3AF" FontSize="13" />
                                <Entry Text="{Binding Email}"
                                       Placeholder="Email"
                                       TextColor="White"
                                       PlaceholderColor="#6B7280"
                                       BackgroundColor="#1F2937"/>
                                <Label Text="{Binding EmailError}"
                                       TextColor="#EF4444"
                                       FontSize="12" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="6">
                                <Label Text="First name" TextColor="#9CA3AF" FontSize="13" />
                                <Entry Text="{Binding FirstName}"
                                       Placeholder="First name"
                                       TextColor="White"
                                       PlaceholderColor="#6B7280"
                                       BackgroundColor="#1F2937"/>
                                <Label Text="{Binding FirstNameError}"
                                       TextColor="#EF4444"
                                       FontSize="12" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="6">
                                <Label Text="Last name" TextColor="#9CA3AF" FontSize="13" />
                                <Entry Text="{Binding LastName}"
                                       Placeholder="Last name"
                                       TextColor="White"
                                       PlaceholderColor="#6B7280"
                                       BackgroundColor="#1F2937"/>
                                <Label Text="{Binding LastNameError}"
                                       TextColor="#EF4444"
                                       FontSize="12" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="6">
                                <Label Text="Role" TextColor="#9CA3AF" FontSize="13" />
                                <Picker ItemsSource="{Binding Roles}"
                                        SelectedItem="{Binding Role}"
                                        TextColor="White"
                                        BackgroundColor="#1F2937" />
                                <Label Text="{Binding RoleError}"
                                       TextColor="#EF4444"
                                       FontSize="12" />
                            </VerticalStackLayout>

                        </VerticalStackLayout>

                    </Border>

                    <Button Text="Save"
                            BackgroundColor="#4F46E5"
                            TextColor="White"
                            CornerRadius="12"
                            HeightRequest="48"
                            FontAttributes="Bold"
                            Command="{Binding SaveCommand}" />

                </VerticalStackLayout>

            </Border>
        </Grid>

    </ScrollView>

</ContentPage>