<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="TaskTracker.Maui.Features.Projects.Views.ProjectsPage"
    BackgroundColor="#0B0F17">

    <Grid RowDefinitions="Auto,*,Auto">

        <Grid Grid.Row="0" Padding="20,24,20,10">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="900" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="1" ColumnDefinitions="*,Auto">

                <VerticalStackLayout Grid.Column="0" Spacing="6">

                    <Label Text="Projects"
                           FontSize="32"
                           FontAttributes="Bold"
                           TextColor="White" />

                    <Label Text="Manage all company projects"
                           FontSize="14"
                           TextColor="#94A3B8" />

                </VerticalStackLayout>

                <HorizontalStackLayout Grid.Column="1"
                                        Spacing="10"
                                        VerticalOptions="Center">

                    <Button Text="↻ Reload"
                            Clicked="OnReload"
                            BackgroundColor="#1E293B"
                            TextColor="White"
                            CornerRadius="14"
                            HeightRequest="46"
                            Padding="18,0" />

                    <Button Text="+ Create"
                            Clicked="OnCreateProject"
                            IsVisible="{Binding CanCreateProject}"
                            BackgroundColor="#4F46E5"
                            TextColor="White"
                            CornerRadius="14"
                            HeightRequest="46"
                            Padding="18,0" />

                </HorizontalStackLayout>

            </Grid>

        </Grid>

        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="900" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <CollectionView Grid.Column="1"
                            ItemsSource="{Binding Projects}"
                            SelectionMode="None"
                            Margin="0,10">

                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical"
                                       ItemSpacing="12" />
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>

                    <DataTemplate>

                        <Border
                            Padding="18"
                            BackgroundColor="#161B22"
                            StrokeThickness="1"
                            Stroke="#222B36"
                            StrokeShape="RoundRectangle 16">

                            <Border.GestureRecognizers>

                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenProjectCommand}"
                                    CommandParameter="{Binding}" />

                            </Border.GestureRecognizers>

                            <Grid ColumnDefinitions="*,Auto"
                                  RowDefinitions="Auto,Auto,Auto">

                                <Label Text="{Binding Title}"
                                       FontSize="20"
                                       FontAttributes="Bold"
                                       TextColor="White"
                                       LineBreakMode="TailTruncation" />

                                <Label Grid.Column="1"
                                       Grid.RowSpan="3"
                                       Text="›"
                                       FontSize="28"
                                       TextColor="#64748B"
                                       VerticalOptions="Center" />

                                <Label Grid.Row="1"
                                       Text="{Binding CustomerCompany}"
                                       FontSize="13"
                                       TextColor="#94A3B8"
                                       Margin="0,6,0,0" />

                                <HorizontalStackLayout Grid.Row="2"
                                                       Spacing="8"
                                                       Margin="0,12,0,0">

                                    <Border Padding="10,4"
                                            BackgroundColor="{Binding ., Converter={StaticResource StatusColorConverter}}"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 20">

                                        <Label Text="{Binding Status}"
                                               FontSize="12"
                                               FontAttributes="Bold"
                                               TextColor="White" />
                                    </Border>

                                    <Border Padding="10,4"
                                            BackgroundColor="{Binding ., Converter={StaticResource PriorityColorConverter}}"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 20">

                                        <Label Text="{Binding Priority}"
                                               FontSize="12"
                                               FontAttributes="Bold"
                                               TextColor="White" />
                                    </Border>

                                </HorizontalStackLayout>

                            </Grid>

                        </Border>

                    </DataTemplate>

                </CollectionView.ItemTemplate>

            </CollectionView>

        </Grid>

        <Grid Grid.Row="2" Padding="20,10,20,20">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="900" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="1"
                    BackgroundColor="#161B22"
                    StrokeThickness="1"
                    Stroke="#222B36"
                    StrokeShape="RoundRectangle 14"
                    Padding="16,10">

                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">

                    <Label Grid.Column="0"
                           Text="{Binding Page, StringFormat='Page {0}'}"
                           TextColor="#9CA3AF"
                           VerticalOptions="Center" />

                    <Button Grid.Column="1"
                            Text="◀ Prev"
                            Command="{Binding PreviousPageCommand}"
                            IsEnabled="{Binding HasPreviousPage}"
                            BackgroundColor="#1F2937"
                            TextColor="White"
                            CornerRadius="10"
                            HeightRequest="40"
                            Padding="14,0" />

                    <Button Grid.Column="2"
                            Text="Next ▶"
                            Command="{Binding NextPageCommand}"
                            IsEnabled="{Binding HasNextPage}"
                            BackgroundColor="#1F2937"
                            TextColor="White"
                            CornerRadius="10"
                            HeightRequest="40"
                            Padding="14,0" />

                </Grid>

            </Border>

        </Grid>

    </Grid>

</ContentPage>