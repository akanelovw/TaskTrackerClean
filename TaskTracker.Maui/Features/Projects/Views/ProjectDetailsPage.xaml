<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="TaskTracker.Maui.Features.Projects.Views.ProjectDetailsPage"
    BackgroundColor="#0B0F17"
    Title="Project">

    <ScrollView>

        <Grid Padding="16" HorizontalOptions="Fill">
            <Border
                StrokeThickness="0"
                BackgroundColor="Transparent"
                HorizontalOptions="Fill"
                MaximumWidthRequest="720">

                <VerticalStackLayout Spacing="16">

                    <Border
                        BackgroundColor="#111827"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 18"
                        Padding="18">

                        <VerticalStackLayout Spacing="8">

                            <Label
                                Text="{Binding Title}"
                                FontSize="28"
                                FontAttributes="Bold"
                                TextColor="White"
                                LineBreakMode="TailTruncation" />

                            <HorizontalStackLayout Spacing="6">
                                <Label
                                    Text="🏢"
                                    FontSize="13"
                                    VerticalOptions="Center" />
                                <Label
                                    Text="{Binding CustomerCompany}"
                                    FontSize="14"
                                    TextColor="#94A3B8"
                                    VerticalOptions="Center" />
                            </HorizontalStackLayout>

                        </VerticalStackLayout>

                    </Border>

                    <Border
                        BackgroundColor="#111827"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 18"
                        Padding="12"
                        IsVisible="{Binding CanEditProject}">

                        <ScrollView Orientation="Horizontal"
                                    HorizontalScrollBarVisibility="Never">

                            <HorizontalStackLayout Spacing="10">

                                <Button
                                    Text="✏️ Edit"
                                    Command="{Binding EditCommand}"
                                    IsVisible="{Binding CanEditProject}"
                                    BackgroundColor="#4F46E5"
                                    TextColor="White"
                                    CornerRadius="12"
                                    HeightRequest="44"
                                    Padding="14,0" />

                                <Button
                                    Text="Status"
                                    Command="{Binding ChangeStatusCommand}"
                                    IsVisible="{Binding CanChangeStatus}"
                                    BackgroundColor="#1F2937"
                                    TextColor="White"
                                    CornerRadius="12"
                                    HeightRequest="44"
                                    Padding="14,0" />

                                <Button
                                    Text="Priority"
                                    Command="{Binding ChangePriorityCommand}"
                                    IsVisible="{Binding CanChangePriority}"
                                    BackgroundColor="#1F2937"
                                    TextColor="White"
                                    CornerRadius="12"
                                    HeightRequest="44"
                                    Padding="14,0" />

                                <Button
                                    Text="🗑 Delete"
                                    Command="{Binding DeleteCommand}"
                                    IsVisible="{Binding CanDeleteProject}"
                                    BackgroundColor="#B91C1C"
                                    TextColor="White"
                                    CornerRadius="12"
                                    HeightRequest="44"
                                    Padding="14,0" />

                            </HorizontalStackLayout>

                        </ScrollView>

                    </Border>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">

                        <Border
                            Padding="14"
                            BackgroundColor="#111827"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 16">

                            <VerticalStackLayout Spacing="8">

                                <Label Text="STATUS"
                                       TextColor="#6B7280"
                                       FontSize="11"
                                       CharacterSpacing="1" />

                                <Border
                                    Padding="10,5"
                                    BackgroundColor="{Binding StatusColor}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 20"
                                    HorizontalOptions="Fill">

                                    <Label
                                        Text="{Binding Status}"
                                        TextColor="White"
                                        FontAttributes="Bold"
                                        FontSize="13"
                                        HorizontalOptions="Center" />

                                </Border>

                            </VerticalStackLayout>

                        </Border>

                        <Border
                            Grid.Column="1"
                            Padding="14"
                            BackgroundColor="#111827"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 16">

                            <VerticalStackLayout Spacing="8">

                                <Label Text="PRIORITY"
                                       TextColor="#6B7280"
                                       FontSize="11"
                                       CharacterSpacing="1" />

                                <Border
                                    Padding="10,5"
                                    BackgroundColor="{Binding PriorityColor}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 20"
                                    HorizontalOptions="Fill">

                                    <Label
                                        Text="{Binding Priority}"
                                        TextColor="White"
                                        FontAttributes="Bold"
                                        FontSize="13"
                                        HorizontalOptions="Center" />

                                </Border>

                            </VerticalStackLayout>

                        </Border>

                    </Grid>

                    <Border
                        Padding="16"
                        BackgroundColor="#111827"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 16">

                        <VerticalStackLayout Spacing="14">

                            <Label Text="Project Info"
                                   FontAttributes="Bold"
                                   TextColor="White"
                                   FontSize="16" />

                            <Grid ColumnDefinitions="120,*"
                                  RowDefinitions="Auto,Auto,Auto"
                                  RowSpacing="10">

                                <Label Text="Executor" TextColor="#6B7280" FontSize="13" />
                                <Label Grid.Column="1"
                                       Text="{Binding ExecutorCompany}"
                                       TextColor="White"
                                       FontSize="13" />

                                <Label Grid.Row="1" Text="Start" TextColor="#6B7280" FontSize="13" />
                                <Label Grid.Row="1" Grid.Column="1"
                                       Text="{Binding StartTime, StringFormat='{0:dd.MM.yyyy}'}"
                                       TextColor="White"
                                       FontSize="13" />

                                <Label Grid.Row="2" Text="End" TextColor="#6B7280" FontSize="13" />
                                <Label Grid.Row="2" Grid.Column="1"
                                       Text="{Binding EndTime, StringFormat='{0:dd.MM.yyyy}'}"
                                       TextColor="White"
                                       FontSize="13" />

                            </Grid>

                            <BoxView HeightRequest="1" Color="#1F2937" />

                            <Button
                                Text="📁 Files"
                                Command="{Binding OpenDocumentsCommand}"
                                IsVisible="{Binding CanUploadDocuments}"
                                BackgroundColor="#1F2937"
                                TextColor="White"
                                CornerRadius="12"
                                HeightRequest="44" />

                        </VerticalStackLayout>

                    </Border>

                    <Border
                        Padding="16"
                        BackgroundColor="#111827"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 16">

                        <VerticalStackLayout Spacing="14">

                            <Label
                                Text="Team"
                                FontAttributes="Bold"
                                FontSize="16"
                                TextColor="White" />

                            <Border
                                Padding="12"
                                BackgroundColor="#0F172A"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 12">

                                <Grid ColumnDefinitions="*,Auto">

                                    <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                        <Label Text="MANAGER"
                                               FontSize="11"
                                               CharacterSpacing="1"
                                               TextColor="#6B7280" />

                                        <Label Text="{Binding ManagerName}"
                                               TextColor="White"
                                               FontAttributes="Bold"
                                               FontSize="15" />
                                    </VerticalStackLayout>

                                    <Button
                                        Grid.Column="1"
                                        Text="Change"
                                        Command="{Binding AssignManagerCommand}"
                                        IsVisible="{Binding CanAssignManager}"
                                        BackgroundColor="#1F2937"
                                        TextColor="White"
                                        CornerRadius="10"
                                        HeightRequest="36"
                                        Padding="12,0"
                                        VerticalOptions="Center" />

                                </Grid>

                            </Border>

                            <Label Text="MEMBERS"
                                   FontSize="11"
                                   CharacterSpacing="1"
                                   TextColor="#6B7280" />

                            <CollectionView ItemsSource="{Binding Members}"
                                            MinimumHeightRequest="60">

                                <CollectionView.EmptyView>
                                    <Grid MinimumWidthRequest="400" HeightRequest="60">
                                        <Label
                                            Text="No members yet"
                                            TextColor="#6B7280"
                                            FontSize="13"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center" />
                                    </Grid>
                                </CollectionView.EmptyView>

                                <CollectionView.ItemTemplate>

                                    <DataTemplate>

                                        <Grid ColumnDefinitions="44,*,Auto"
                                              Padding="0,8"
                                              ColumnSpacing="12">

                                            <Border
                                                WidthRequest="40"
                                                HeightRequest="40"
                                                BackgroundColor="#312E81"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 20"
                                                VerticalOptions="Center">

                                                <Label
                                                    Text="{Binding FullName, Converter={StaticResource InitialsConverter}}"
                                                    TextColor="White"
                                                    FontAttributes="Bold"
                                                    FontSize="13"
                                                    HorizontalOptions="Center"
                                                    VerticalOptions="Center" />

                                            </Border>

                                            <VerticalStackLayout
                                                Grid.Column="1"
                                                VerticalOptions="Center"
                                                Spacing="2">

                                                <Label
                                                    Text="{Binding FullName}"
                                                    TextColor="White"
                                                    FontAttributes="Bold"
                                                    FontSize="14" />

                                                <Label
                                                    Text="{Binding Role}"
                                                    TextColor="#94A3B8"
                                                    FontSize="12" />

                                            </VerticalStackLayout>

                                            <Button
                                                Grid.Column="2"
                                                Text="Remove"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.RemoveMemberCommand}"
                                                CommandParameter="{Binding}"
                                                IsVisible="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.CanRemoveMember}"
                                                BackgroundColor="#7F1D1D"
                                                TextColor="White"
                                                CornerRadius="8"
                                                HeightRequest="32"
                                                Padding="10,0"
                                                VerticalOptions="Center" />

                                        </Grid>

                                    </DataTemplate>

                                </CollectionView.ItemTemplate>

                            </CollectionView>
                            
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10" Margin="0,4,0,0"
                                IsVisible="{Binding HasNextMembersPage, FallbackValue=False}">

                                <Label Grid.Column="0"
                                   Text="{Binding MembersPageLabel}"
                                   TextColor="#9CA3AF"
                                   VerticalOptions="Center" />

                                <Button Grid.Column="1"
                                    Text="◀"
                                    Command="{Binding PreviousMembersPageCommand}"
                                    IsEnabled="{Binding HasPreviousMembersPage}"
                                    BackgroundColor="#1F2937"
                                    TextColor="White"
                                    CornerRadius="10"
                                    WidthRequest="44"
                                    HeightRequest="36" />

                                <Button Grid.Column="2"
                                    Text="▶"
                                    Command="{Binding NextMembersPageCommand}"
                                    IsEnabled="{Binding HasNextMembersPage}"
                                    BackgroundColor="#1F2937"
                                    TextColor="White"
                                    CornerRadius="10"
                                    WidthRequest="44"
                                    HeightRequest="36" />

                            </Grid>
                            
                            <Button
                                Text="+ Add Member"
                                Command="{Binding AddMemberCommand}"
                                IsVisible="{Binding CanAddMember}"
                                BackgroundColor="#4F46E5"
                                TextColor="White"
                                CornerRadius="10"
                                HeightRequest="40" />

                        </VerticalStackLayout>

                    </Border>

                    <Border
                        Padding="16"
                        BackgroundColor="#111827"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 16">

                        <VerticalStackLayout Spacing="14">

                            <Grid ColumnDefinitions="*,Auto">

                                <Label
                                    Text="Tasks"
                                    FontSize="16"
                                    FontAttributes="Bold"
                                    TextColor="White"
                                    VerticalOptions="Center" />

                                <Button
                                    Grid.Column="1"
                                    Text="+ Create"
                                    Command="{Binding CreateWorkItemCommand}"
                                    IsVisible="{Binding CanCreateWorkItem}"
                                    BackgroundColor="#4F46E5"
                                    TextColor="White"
                                    CornerRadius="10"
                                    HeightRequest="38"
                                    Padding="14,0" />

                            </Grid>

                            <CollectionView ItemsSource="{Binding WorkItemsVM.WorkItems}">

                                <CollectionView.ItemsLayout>
                                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
                                </CollectionView.ItemsLayout>

                                <CollectionView.ItemTemplate>

                                    <DataTemplate>

                                        <Border
                                            Padding="14"
                                            BackgroundColor="#0F172A"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 14">

                                            <Border.GestureRecognizers>

                                                <TapGestureRecognizer
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.WorkItemsVM.OpenTaskCommand}"
                                                    CommandParameter="{Binding .}" />

                                            </Border.GestureRecognizers>

                                            <VerticalStackLayout Spacing="6">

                                                <Label Text="{Binding Title}"
                                                       TextColor="White"
                                                       FontAttributes="Bold"
                                                       FontSize="15" />

                                                <Label Text="{Binding Comment}"
                                                       TextColor="#94A3B8"
                                                       FontSize="13"
                                                       LineBreakMode="TailTruncation"
                                                       MaxLines="2" />

                                                <Label Text="{Binding AssignedUser.FullName}"
                                                       TextColor="#64748B"
                                                       FontSize="12" />

                                                <HorizontalStackLayout Spacing="8" Margin="0,4,0,0">

                                                    <Border
                                                        Padding="8,3"
                                                        BackgroundColor="#1E3A8A"
                                                        StrokeThickness="0"
                                                        StrokeShape="RoundRectangle 10">
                                                        <Label Text="{Binding Status}"
                                                               TextColor="#93C5FD"
                                                               FontSize="11" />
                                                    </Border>

                                                    <Border
                                                        Padding="8,3"
                                                        BackgroundColor="#78350F"
                                                        StrokeThickness="0"
                                                        StrokeShape="RoundRectangle 10">
                                                        <Label Text="{Binding Priority}"
                                                               TextColor="#FCD34D"
                                                               FontSize="11" />
                                                    </Border>

                                                </HorizontalStackLayout>

                                            </VerticalStackLayout>

                                        </Border>

                                    </DataTemplate>

                                </CollectionView.ItemTemplate>

                            </CollectionView>

                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10" Margin="0,8,0,0">

                                <Label Grid.Column="0"
                                       Text="{Binding WorkItemsVM.Page, StringFormat='Page {0}'}"
                                       TextColor="#9CA3AF"
                                       VerticalOptions="Center" />

                                <Button Grid.Column="1"
                                        Text="◀"
                                        Command="{Binding WorkItemsVM.PreviousPageCommand}"
                                        IsEnabled="{Binding WorkItemsVM.HasPreviousPage}"
                                        BackgroundColor="#1F2937"
                                        TextColor="White"
                                        CornerRadius="10"
                                        WidthRequest="44"
                                        HeightRequest="36" />

                                <Button Grid.Column="2"
                                        Text="▶"
                                        Command="{Binding WorkItemsVM.NextPageCommand}"
                                        IsEnabled="{Binding WorkItemsVM.HasNextPage}"
                                        BackgroundColor="#1F2937"
                                        TextColor="White"
                                        CornerRadius="10"
                                        WidthRequest="44"
                                        HeightRequest="36" />

                            </Grid>

                        </VerticalStackLayout>

                    </Border>

                </VerticalStackLayout>

            </Border>

        </Grid>

    </ScrollView>

</ContentPage>