<toolkit:Popup
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:Class="TaskTracker.Maui.Popups.EditWorkItemPopup"
    CanBeDismissedByTappingOutsideOfPopup="False"
    BackgroundColor="Transparent">
    
    <Border
        BackgroundColor="#111827"
        Padding="24"
        StrokeShape="RoundRectangle 20"
        StrokeThickness="1"
        Stroke="#222B36"
        WidthRequest="360">

        <VerticalStackLayout Spacing="16">

            <Label
                Text="Edit task"
                FontSize="20"
                FontAttributes="Bold"
                TextColor="White"/>

            <VerticalStackLayout Spacing="6">

                <Label Text="Title" TextColor="#9CA3AF" FontSize="13" />

                <Entry
                    x:Name="TitleEntry"
                    Placeholder="Title"
                    TextColor="White"
                    PlaceholderColor="#6B7280"
                    BackgroundColor="#1F2937"/>

                <Label
                    x:Name="TitleErrorLabel"
                    TextColor="#EF4444"
                    FontSize="12"/>

            </VerticalStackLayout>

            <VerticalStackLayout Spacing="6">

                <Label Text="Comment" TextColor="#9CA3AF" FontSize="13" />

                <Border
                    BackgroundColor="#1F2937"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 12"
                    Padding="12,4">

                    <Editor
                        x:Name="CommentEditor"
                        Placeholder="Comment"
                        TextColor="White"
                        PlaceholderColor="#6B7280"
                        BackgroundColor="Transparent"
                        AutoSize="TextChanges"
                        HeightRequest="100"/>

                </Border>

                <Label
                    x:Name="CommentErrorLabel"
                    TextColor="#EF4444"
                    FontSize="12"/>

            </VerticalStackLayout>

            <Grid ColumnDefinitions="*,*"
                  ColumnSpacing="12">

                <Button
                    Text="Cancel"
                    BackgroundColor="#374151"
                    TextColor="White"
                    CornerRadius="10"
                    HeightRequest="44"
                    Clicked="CancelClicked"/>

                <Button
                    Grid.Column="1"
                    Text="Save"
                    BackgroundColor="#4F46E5"
                    TextColor="White"
                    CornerRadius="10"
                    HeightRequest="44"
                    Clicked="SaveClicked"/>

            </Grid>

        </VerticalStackLayout>

    </Border>

</toolkit:Popup>