# ===== Environment =====
# Development — включает Scalar UI на /scalar/v1, подробные ошибки.
# Production — для реального использования.
ASPNETCORE_ENVIRONMENT=Production

# ===== Database =====
# По умолчанию указывает на контейнер БД из docker-compose (сервис "db").
# Если хотите подключить СВОЮ базу данных (внешний сервер, облако и т.д.) —
# просто замените всю строку на вашу собственную connection string.
DB_CONNECTION_STRING=Server=db,1433;Database=TaskTrackerDb;User Id=sa;Password=YourStr0ng!DbPassword;TrustServerCertificate=True

# Пароль для SA-пользователя в контейнере MS SQL Server (используется ТОЛЬКО
# если вы используете встроенную в docker-compose базу данных, сервис "db").
# Должен совпадать с паролем, указанным в DB_CONNECTION_STRING выше.
# Требования MS SQL Server: заглавные + строчные буквы + цифры + спецсимволы, мин. 8 символов.
DB_PASSWORD=YourStr0ng!DbPassword

# ===== JWT =====
# Секретный ключ для подписи токенов, минимум 32 символа
JWT_KEY=YourSuperSecretJwtKey_AtLeast32Characters_Long!

# ===== Admin seed =====
# Учётные данные администратора, создаваемого автоматически при первом запуске
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=YourStr0ng!AdminPassword

# ===== Domain / HTTPS =====
# Если деплоите на сервер с доменом — впишите домен, и Caddy автоматически
# получит SSL-сертификат от Let's Encrypt. Для локального запуска оставьте пустым.
DOMAIN=
ACME_EMAIL=

# ===== API =====
# Порт, на котором Caddy публикует API наружу
API_PORT=8080